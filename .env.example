# --- APPLICATION & SERVER PORT ---
# Default port in Docker is 3020 (to avoid conflict with ports 3000/3001 on shared VM)
PORT=3020
APP_HOST_PORT=3020

# --- DATABASE (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=recruitment_db
# Host port bound to 127.0.0.1 (5435 avoids conflict with 5432 and 5433 on shared VM)
DB_HOST_PORT=5435
DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5435/recruitment_db?schema=public

# --- NEXTAUTH (Auth.js) ---
# Production: https://portal.dpp.co.id | Staging: https://portal-staging.dpp.co.id | Local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Generate a secret using: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# --- FEATURE FLAGS ---
# Set to `true` in local development to keep Candidate Portal (/candidate/*) and Public Jobs (/jobs/*) accessible.
# Set to `false` in Staging and Production until public portal security hardening is signed off.
FEATURE_CANDIDATE_PORTAL=true
FEATURE_PUBLIC_JOBS=true

# --- GOOGLE OAUTH (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OBJECT STORAGE (Cloudflare R2 / S3-Compatible) ---
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (with S3_REGION=auto)
# For Local MinIO: http://localhost:9000 (with S3_REGION=us-east-1)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=recruitment-bucket
S3_REGION=auto
