generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  password         String?
  department       String?
  emailVerified    DateTime?
  image            String?
  role             UserRole          @default(CANDIDATE)
  accounts         Account[]
  candidateProfile CandidateProfile?
  sessions         Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MasterProvince {
  id       String             @id @default(cuid())
  code     String?            @unique
  name     String
  profiles CandidateProfile[]
  jobs     JobOpening[]
  cities   MasterCity[]
  sites    MasterSite[]
  clinics  MasterClinic[]
}

model MasterCity {
  id         String             @id @default(cuid())
  code       String?            @unique
  name       String
  provinceId String
  profiles   CandidateProfile[]
  jobs       JobOpening[]
  province   MasterProvince     @relation(fields: [provinceId], references: [id])
  sites      MasterSite[]
}

model MasterCustomer {
  id    String       @id @default(cuid())
  code  String?      @unique
  name  String
  jobs  JobOpening[]
  sites MasterSite[]
}

model MasterSite {
  id             String         @id @default(cuid())
  code           String?        @unique
  name           String
  latitude       Float?
  longitude      Float?
  customerId     String
  cityId         String
  provinceId     String
  useSpecificSla Boolean        @default(false)
  mcuPackage     String?
  jobs           JobOpening[]
  city           MasterCity     @relation(fields: [cityId], references: [id])
  customer       MasterCustomer @relation(fields: [customerId], references: [id])
  province       MasterProvince @relation(fields: [provinceId], references: [id])
  siteSlas       SiteSla[]
}

model MasterClinic {
  id         String         @id @default(cuid())
  code       String?        @unique
  name       String
  provinceId String
  address    String
  province   MasterProvince @relation(fields: [provinceId], references: [id])
}

model MasterPosition {
  id   String       @id @default(cuid())
  code String?      @unique
  name String
  jobs JobOpening[]
}

model MasterPipelineStage {
  id                String                   @id @default(cuid())
  name              String
  orderIndex        Int
  slaDays           Int                      @default(3)
  reminderDays      Int                      @default(1)
  applications      Application[]            @relation("CurrentStage")
  appHistories      ApplicationHistory[]
  jobTimelines      JobTimeline[]
  rejectionMessages MasterRejectionMessage[]
  siteSlas          SiteSla[]
}

model SiteSla {
  id           String              @id @default(cuid())
  siteId       String
  stageId      String
  slaDays      Int
  reminderDays Int
  site         MasterSite          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stage        MasterPipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([siteId, stageId])
}

model MasterRejectionMessage {
  id      String              @id @default(cuid())
  message String
  code    String?             @unique
  stageId String
  stage   MasterPipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model MasterInstitute {
  id       String  @id @default(cuid())
  code     String? @unique
  name     String
  address  String?
  city     String?
  province String?
  status   String?
  type     String?
}

model MasterDepartment {
  id   String       @id @default(cuid())
  code String?      @unique
  name String
  jobs JobOpening[]
}

model MasterCertificationSchema {
  id   String  @id @default(cuid())
  code String? @unique
  name String
}

model MasterRequestType {
  id   String  @id @default(cuid())
  code String? @unique
  name String
}

model MasterCertification {
  id   String  @id @default(cuid())
  code String? @unique
  name String
}

model CandidateProfile {
  id                 String              @id @default(cuid())
  userId               String              @unique
  nik                  String?             @unique
  kk                   String?
  birthPlace           String?
  birthDate            DateTime?
  gender               String?
  religion             String?
  maritalStatus        String?
  whatsapp             String?
  emergencyContact     String?
  domicileAddress      String?
  currentAddress       String?
  educationType        String?
  latestEducation      String?
  educationInstitution String?
  trainingCenterType   String?
  trainingCenterName   String?
  cityId               String?
  provinceId           String?
  isProfileCompleted   Boolean             @default(false)
  isTalentPool       Boolean             @default(false)
  isBlacklisted      Boolean             @default(false)
  blacklistReason    String?
  blacklistedAt      DateTime?
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  applications       Application[]
  documents          CandidateDocument[]
  city               MasterCity?         @relation(fields: [cityId], references: [id])
  province           MasterProvince?     @relation(fields: [provinceId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateDocument {
  id                 String           @id @default(cuid())
  candidateProfileId String
  documentType       String
  fileUrl            String
  objectKey          String
  mimeType           String?
  sizeBytes          Int?
  createdAt          DateTime         @default(now())
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
}

model JobOpening {
  id                String            @id @default(cuid())
  noRegistrasi      String            @unique
  positionId        String?
  customerId        String
  cityId            String
  provinceId        String
  siteId            String
  statusPermintaan  String
  jumlahPermintaan  Int
  tanggalMasuk      DateTime
  status            JobStatus         @default(DRAFT)
  isPriority        Boolean           @default(false)
  requiresSkillTest Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  departmentId      String?
  departmentName    String?
  positionName      String?
  benefit           String?
  district          String?
  kualifikasi       String?
  noFormB1          String?
  requiresBnsp      Boolean           @default(false)
  publishedDate     DateTime?
  applications      Application[]
  city              MasterCity        @relation(fields: [cityId], references: [id])
  customer          MasterCustomer    @relation(fields: [customerId], references: [id])
  department        MasterDepartment? @relation(fields: [departmentId], references: [id])
  position          MasterPosition?   @relation(fields: [positionId], references: [id])
  province          MasterProvince    @relation(fields: [provinceId], references: [id])
  site              MasterSite        @relation(fields: [siteId], references: [id])
  timeline          JobTimeline[]
}

model JobTimeline {
  id           String              @id @default(cuid())
  jobId        String
  stageId      String
  status       String              @default("Pending")
  startDate    DateTime
  deadlineDate DateTime
  job          JobOpening          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage        MasterPipelineStage @relation(fields: [stageId], references: [id])

  @@unique([jobId, stageId])
}

model Application {
  id                 String               @id @default(cuid())
  jobId              String
  candidateProfileId String
  currentStageId     String?
  status             ApplicationStatus    @default(ACTIVE)
  applicationDate    DateTime             @default(now())
  stageData          Json?                @default("{}")
  candidateProfile   CandidateProfile     @relation(fields: [candidateProfileId], references: [id])
  currentStage       MasterPipelineStage? @relation("CurrentStage", fields: [currentStageId], references: [id])
  job                JobOpening           @relation(fields: [jobId], references: [id])
  history            ApplicationHistory[]
  interviews         Interview[]
}

model ApplicationHistory {
  id            String               @id @default(cuid())
  applicationId String
  stageId       String?
  stageName     String
  date          DateTime             @default(now())
  note          String?
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         MasterPipelineStage? @relation(fields: [stageId], references: [id])
}

model Interview {
  id              String      @id @default(cuid())
  applicationId   String
  type            String
  title           String
  scheduledAt     DateTime
  durationMinutes Int         @default(60)
  locationOrLink  String?
  interviewerName String?
  createdAt       DateTime    @default(now())
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  OVERDUE
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  HIRED
  WITHDRAWN
}
